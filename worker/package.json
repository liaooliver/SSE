{
  "name": "sse-install-worker",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/unit tests/e2e",
    "test:perf": "vitest run tests/perf",
    "postinstall": "npm rebuild esbuild workerd"
  },
  "prettier": {
    "printWidth": 100
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261123.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
